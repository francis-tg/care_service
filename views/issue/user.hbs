<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signalement</title>
    <link href="/css/output.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="/css/lineicons.css" rel="stylesheet" type="text/css" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self';">
</head>

<body class="bg-gray-100">
    <div class="navbar bg-base-100 shadow-lg mb-8">
        <div class="flex-1">
            <a class="btn btn-ghost normal-case text-xl" href="/"><i class="lni lni-arrow-left"></i>Signalement</a>
        </div>
        <div class="flex-none">
            <a class="btn btn-primary" href="#" onclick="my_modal_1.showModal()">Signaler un problème</a>
        </div>
    </div>

    <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold mb-6">Problèmes</h2>

        <div class="overflow-x-auto">
            <table class="table w-full" table-sort>
                <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Asigné à</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each issues}}
                    <tr>
                        <td>{{escape name}}</td>
                        <td>{{escape description}}</td>
                        <td>
                            <span class="badge badge-warning">{{escape "Intervention.status"}}</span>
                        </td>
                        <td>
                            {{escape "Intervention.technician.name"}}
                        </td>
                        <td>
                            <a href="#" onclick="show{{id}}.showModal()" class="btn btn-info btn-xs">Voir</a>
                            <a href="#" class="btn btn-primary btn-xs" onclick="edit{{id}}.showModal()">Modifier</a>
                            <a confirm confirm-msg="Cet action est irréversible" href="/issue/delete/{{id}}" class="btn btn-error btn-xs">Supprimer</a>
                        </td>
                    </tr>

                    <dialog id="show{{id}}" class="modal">
                        <div class="modal-box">
                            <h3 class="text-lg font-bold">{{escape name}}</h3>
                            <p class="py-4">{{escape description}}</p>
                            <div class="modal-action">
                                <form method="dialog">
                                    <button class="btn">Fermer</button>
                                </form>
                            </div>
                        </div>
                    </dialog>
                    <dialog id="edit{{id}}" class="modal">
                        <div class="modal-box">
                            <h3 class="text-lg font-bold">{{escape name}}</h3>
                            <form method="post" action="/issue/update/{{id}}">
                                <input type="hidden" name="_csrf" value="{{csrfToken}}">
                                <div class="form-control mt-4">
                                    <label class="label">
                                        <span class="label-text">Intitulé</span>
                                    </label>
                                    <input type="text" name="name" value="{{escape name}}" class="input input-bordered" required>
                                </div>
                                <div class="form-control mt-4">
                                    <label class="label">
                                        <span class="label-text">Lieu</span>
                                    </label>
                                    <input type="text" name="location" value="{{escape location}}" class="input input-bordered" required>
                                </div>
                                <div class="form-control mt-4">
                                    <label class="label">
                                        <span class="label-text">Date</span>
                                    </label>
                                    <input type="date" name="end" value="{{inputDate end}}" class="input input-bordered" required>
                                </div>
                                <div class="form-control mt-4">
                                    <label class="label">
                                        <span class="label-text">Description</span>
                                    </label>
                                    <textarea name="description" class="textarea textarea-bordered" required>{{escape description}}</textarea>
                                </div>
                                <div class="form-control mt-6">
                                    <button class="btn btn-primary w-full">Modifier</button>
                                </div>
                            </form>
                            <div class="modal-action">
                                <form method="dialog">
                                    <button class="btn">Fermer</button>
                                </form>
                            </div>
                        </div>
                    </dialog>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    <dialog id="my_modal_1" class="modal">
        <div class="modal-box">
            <h3 class="font-bold text-lg">Signaler un nouveau problème</h3>
            <form method="post" action="/issue/create">
                <input type="hidden" name="_csrf" value="{{csrfToken}}">
                <div class="form-control mt-4">
                    <label class="label">
                        <span class="label-text">Intitulé</span>
                    </label>
                    <input type="text" name="name" class="input input-bordered" required>
                </div>
                <div class="form-control mt-4">
                    <label class="label">
                        <span class="label-text">Lieu</span>
                    </label>
                    <input type="text" name="location" class="input input-bordered" required>
                </div>
                <div class="form-control mt-4">
                    <label class="label">
                        <span class="label-text">Date</span>
                    </label>
                    <input type="date" name="end" class="input input-bordered" required>
                </div>
                <div class="form-control mt-4">
                    <label class="label">
                        <span class="label-text">Description</span>
                    </label>
                    <textarea name="description" class="textarea textarea-bordered" required></textarea>
                </div>
                <div class="form-control mt-6">
                    <button class="btn btn-primary w-full">Signaler</button>
                </div>
            </form>
            <div class="modal-action">
                <form method="dialog">
                    <button class="btn">Fermer</button>
                </form>
            </div>
        </div>
    </dialog>
</body>

</html>