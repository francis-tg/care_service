<div class="container-fluid">
    <div class="table-wrapper py-5 table-responsive">
        <table class="table" table-sort>
            <thead>
                <tr>
                    <th class="lead-info">
                        <h6>Nom</h6>
                    </th>
                    <th class="lead-company">
                        <h6>Description</h6>
                    </th>
                    <th class="lead-email">
                        <h6>Technicien</h6>
                    </th>
                    <th class="lead-phone">
                        <h6>Status</h6>
                    </th>
                    <th>
                        <h6>Action</h6>
                    </th>
                </tr>
            </thead>
            <tbody>
                {{#each interventions}}
                <tr>
                    <td class="min-width">
                        <div class="lead">
                            <div class="lead-text">
                                <p>{{Issue.name}}</p>
                            </div>
                        </div>
                    </td>
                    <td class="min-width">
                        <p>{{shortTextObject Issue.description}}</p>
                    </td>
                    <td class="min-width">
                        <p><a href="tel:{{technician.contact}}">{{technician.name}}</a></p>
                    </td>
                    <td class="min-width">
                        <p>
                            <a href="#">
                                <span class="badge rounded-pill 
                                    {{#if_eq status 'Terminé'}} text-bg-success 
                                    {{else if_eq status 'En cours'}} text-bg-warning 
                                    {{else if_eq status 'Accepté'}} text-bg-info 
                                    {{else}} text-bg-secondary 
                                    {{/if_eq}}">
                                    {{status}}
                                </span>
                            </a>
                        </p>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <button class="btn btn-info" data-bs-toggle="modal" data-bs-target="#detail{{id}}">
                                <i class="lni lni-information"></i> Détail
                            </button>
                            {{#if_eq status 'Terminé'}}
                                <!-- Action pour les interventions terminées -->
                            {{else}}
                                {{#if_eq status "En cours" }}
                                    <a href="/me/intervention/{{id}}/end" class="btn btn-danger">
                                        <i class="lni lni-close"></i> Terminer
                                    </a>
                                {{else}}
                                    {{#if_eq status "Accepté"}}
                                        <a href="/me/intervention/{{id}}/start" class="btn btn-success">
                                            <i class="lni lni-start"></i> Commencer
                                        </a>
                                    {{else}}
                                        <a href="/me/intervention/{{id}}/accept" class="btn btn-success">
                                            <i class="lni lni-checkmark-circle"></i> Accepter
                                        </a>
                                        <a href="/me/intervention/{{id}}/close" class="btn btn-danger">
                                            <i class="lni lni-close"></i> Refuser
                                        </a>
                                    {{/if_eq}}
                                {{/if_eq}}
                            {{/if_eq}}
                        </div>
                    </td>
                </tr>

                <!-- Modal -->
<!-- Modal -->
<div class="modal fade" id="detail{{id}}" tabindex="-1" role="dialog" aria-labelledby="modalTitleId" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content rounded-3 shadow-lg">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="modalTitleId">{{Issue.name}}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">{{Issue.description}}</p>
                <p>Date: <strong>{{Issue.end}} (GMT+1)</strong></p>
                <h5 class="mt-3">
                    <i class="lni lni-pin text-primary"></i> Lieu de l'intervention: <strong>{{Issue.location}}</strong>
                </h5>
                <hr>
                {{!-- <h6 class="text-secondary">Informations du client:</h6>
                <ul class="list-unstyled">
                    <li><strong>Nom:</strong> {{name}}</li>
                    <li><strong>Email:</strong> {{email}}</li>
                    <li><strong>Téléphone:</strong> {{phone}}</li>
                </ul>
                <h6 class="text-secondary">Détails supplémentaires:</h6>
                <ul class="list-unstyled">
                    <li><strong>Durée estimée:</strong> {{Issue.duration}}</li>
                    <li><strong>Priorité:</strong> <span class="badge bg-warning text-dark">{{Issue.priority}}</span></li>
                </ul> --}}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<style>
    .modal-header {
        border-bottom: 2px solid #0056b3;
    }

    .modal-title {
        font-weight: 700;
        font-size: 1.5rem;
    }

    .modal-body {
        font-family: 'Arial', sans-serif;
        line-height: 1.6;
        color: #333;
    }

    .modal-footer {
        justify-content: flex-end;
    }

    .btn-secondary {
        background-color: #6c757d;
        border: none;
    }

    .btn-secondary:hover {
        background-color: #5a6268;
    }

    @media (max-width: 768px) {
        .modal-dialog {
            width: 90%;
            margin: auto;
        }
    }
</style>

                {{/each}}
            </tbody>
        </table>
    </div>
</div>
