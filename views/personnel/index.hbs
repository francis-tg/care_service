<div class="tables-wrapper">
    <div class="row">
        <div class="col-lg-12">
            <div class="card-style mb-30">
                <h6 class="mb-10">Personnel</h6>
                <div class="flex justify-content-end">
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addUser">Ajouter un personnel</button>
                </div>
                <div class="table-wrapper table-responsive">
                    <table class="table" table-sort>
                        <thead>
                            <tr>
                                <th class="lead-info"><h6>Nom</h6></th>
                                <th class="lead-company"><h6>Prénom</h6></th>
                                <th class="lead-email"><h6>E-mail</h6></th>
                                <th class="lead-phone"><h6>N° de téléphone</h6></th>
                                <th><h6>Action</h6></th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each personnels}}
                            <tr>
                                <td class="min-width">
                                    <div class="lead">
                                        <div class="lead-image">
                                            <img src="/images/profile/default.png" alt="">
                                        </div>
                                        <div class="lead-text">
                                            <p>{{name}}</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="min-width"><p>{{lastname}}</p></td>
                                <td class="min-width"><p><a href="mailto:{{email}}">{{email}}</a></p></td>
                                <td class="min-width"><p><a href="tel:{{contact}}">{{contact}}</a></p></td>
                                <td>
                                    <div class="action">
                                        <a href="#" class="btn btn-sm btn-warning me-2" data-bs-toggle="modal" data-bs-target="#editPersonnel{{id}}">
                                            <i class="lni lni-pencil-alt"></i>
                                        </a>
                                        <a href="/admin/personnel/remove/{{id}}" confirm confirm-msg="Cet action est irréversible" class="btn btn-sm btn-danger">
                                            <i class="lni lni-trash-can"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>

                            <div class="modal fade" id="editPersonnel{{id}}" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" role="dialog" aria-labelledby="modalTitleId" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="modalTitleId">Modifier</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <form action="/admin/personnel/update/{{id}}" method="post">
                                                <div class="mb-3">
                                                    <label for="name" class="form-label">Nom</label>
                                                    <input type="text" class="form-control" name="name" id="name" value="{{name}}" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label for="lastname" class="form-label">Prénom</label>
                                                    <input type="text" class="form-control" name="lastname" id="lastname" value="{{lastname}}" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label for="email" class="form-label">Email</label>
                                                    <input type="email" class="form-control" name="email" id="email" value="{{email}}" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label for="contact" class="form-label">N° de téléphone</label>
                                                    <input type="tel" class="form-control" name="contact" id="contact" value="{{contact}}" required />
                                                </div>
                                                <button type="submit" class="btn btn-primary w-100">Modifier</button>
                                            </form>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="modal modal-center fade" id="addUser" tabindex="-1" role="dialog" aria-labelledby="modalTitleId" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitleId">Ajouter un personnel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form action="/admin/personnel/create" method="post">
                        <input type="hidden" name="_csrf" value="{{csrfToken}}">
                        <div class="mb-3">
                            <label for="name" class="form-label">Nom</label>
                            <input type="text" class="form-control" name="name" id="name" required />
                        </div>
                        <div class="mb-3">
                            <label for="lastname" class="form-label">Prénom</label>
                            <input type="text" class="form-control" name="lastname" id="lastname" required />
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" name="email" id="email" required />
                        </div>
                        <div class="mb-3">
                            <label for="contact" class="form-label">N° de téléphone</label>
                            <input type="tel" class="form-control" name="contact" id="contact" required />
                        </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
                    </form>
            </div>
        </div>
    </div>
</div>